# ---------------------------------------------------------------------------
# GrowBusiness Online — backend configuration
# Copy this file to `.env` and change the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# HTTP
PORT=4000
NODE_ENV=development

# Public origins allowed to call the API (comma separated).
# Local dev + Hostinger preview hosts. Use your real domain in production.
CORS_ORIGINS=http://localhost:4000,http://localhost:5173,https://growbusinessonline.com

# Root domain used to resolve vendor subdomains (vendor1.growbusinessonline.com)
ROOT_DOMAIN=growbusinessonline.com

# --- Secrets (REQUIRED in production) ---------------------------------------
# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Shared secret the payment gateway must send when confirming a deposit.
# The browser can never produce this, so a vendor cannot fake "payment success".
GATEWAY_WEBHOOK_SECRET=change-me-gateway-secret

# --- Business rules ---------------------------------------------------------
CURRENCY=INR
PLATFORM_COMMISSION_PERCENT=5
SECURITY_DEPOSIT_PAISE=100000
ACTIVATION_HOURS=48
DEFAULT_DELIVERY_FEE_PAISE=4900
FREE_DELIVERY_ABOVE_PAISE=99900
GST_PERCENT=0
TAXABLE=false

# --- Feature flags ----------------------------------------------------------
# Serves the compiled static frontend from ../frontend (single-port dev mode).
SERVE_FRONTEND=true
# Allows POST /api/dev/simulate-payment (demo gateway callback). Must be false in production.
DEV_TOOLS=true
# Shortens the 48h activation window to 60s so the countdown can be demoed.
DEV_FAST_ACTIVATION=false
